    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality-gate": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
